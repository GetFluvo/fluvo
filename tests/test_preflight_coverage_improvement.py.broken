            result = preflight._validate_header(
                ["id", "name", "email"],
                {"id": {"type": "integer"}, "name": {"type": "char", "readonly": True, "store": True}, "email": {"type": "char", "readonly": True, "store": True}},
                "res.partner"
            )

            # Should return True when multiple readonly fields are valid
            assert result is True


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
